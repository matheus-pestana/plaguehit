{
  "expo": {
    "name": "PlagueHit",
    "slug": "PlagueHit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/chip.png",
    "scheme": "plaguehit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C9953",
        "foregroundImage": "./src/assets/images/chip.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.matheusap.PlagueHit"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/chip.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "appearance": "light",
          // "backgroundColor": "#6C9953"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/chip.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6C9953",
          "dark": {
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "appearance": "light",
        "backgroundColor": "#6C9953"
      },
      "eas": {
        "projectId": "47b25db9-5585-44cf-b11b-c80c2936ab3a"
      }
    }
  }
}
